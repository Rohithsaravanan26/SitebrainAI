{
  "name": "sitebrain-ai-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise AI-powered Construction Intelligence Platform - Monorepo Root",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "pnpm --recursive run typecheck",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@sitebrain/eslint-config": "workspace:*",
    "@sitebrain/tsconfig": "workspace:*",
    "husky": "^8.0.3",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
